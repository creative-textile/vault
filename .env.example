# ═══════════════════════════════════════════════════════════════════════════
# VAULT — переменные окружения
#
# Скопируйте в .env и заполните:  cp .env.example .env
# Файл .env в .gitignore — не коммитьте секреты.
#
# ВАЖНО: значения пишутся БЕЗ кавычек и БЕЗ комментариев в той же строке.
# docker compose читает .env построчно, поэтому «ADMIN_PASSWORD=admin # коммент»
# может попасть в значение вместе с текстом комментария.
# ═══════════════════════════════════════════════════════════════════════════

# ── Режим работы ────────────────────────────────────────────────────────────
# true  — демо: вход по demo:<telegram_id>, демо-пополнение, мгновенные выводы.
# false — реальные деньги: демо-вход и демо-пополнение отключаются на сервере,
#         а backend отказывается стартовать без секретов ниже.
DEMO_MODE=true

# ── Telegram ────────────────────────────────────────────────────────────────
# Токен бота от @BotFather. Без него реальная авторизация Telegram невозможна:
# backend проверяет подпись initData по HMAC именно этим токеном.
BOT_TOKEN=your_bot_token

# Юзернейм того же бота, БЕЗ @. Подставляется в реферальные ссылки
# https://t.me/<BOT_USERNAME>?start=<код>. При несовпадении с BOT_TOKEN ссылки
# ведут в чужой бот (бот сам пишет предупреждение в лог при старте).
BOT_USERNAME=vault_game_bot

# URL Mini App (frontend). На него же открывается кнопка «ИГРАТЬ» в боте.
WEBAPP_URL=https://vault-app.com

# Origins, которым разрешено обращаться к API и сокету (через запятую).
# Сокет больше не принимает '*': укажите реальный домен приложения.
ALLOWED_ORIGINS=https://vault-app.com

# ── Доступ администратора ───────────────────────────────────────────────────
# Telegram ID админов через запятую. Вне демо-режима список обязателен:
# доступ в админ-панель получают только они (плюс пароль ниже).
# В демо при ПУСТОМ списке панель открыта любому залогиненному (для локальной
# проверки); если список задан — он проверяется и в демо.
ADMIN_TELEGRAM_IDS=123456789,987654321

# Пароль админ-панели (заголовок X-Admin-Password).
ADMIN_PASSWORD=change_me_to_a_strong_password

# ── Секреты ─────────────────────────────────────────────────────────────────
# Подпись JWT. Вне демо запрещены значения по умолчанию.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_64_random_characters

# Pepper для HMAC телеметрии (ip/device хэши). Отдельный от JWT_SECRET.
SECURITY_PEPPER=replace_with_another_random_secret

# ── TON (пополнения и выплаты) ──────────────────────────────────────────────
TON_API_KEY=your_ton_api_key
TON_WALLET_MNEMONIC=twenty four word mnemonic phrase here
USDT_JETTON_ADDRESS=EQCxE6TUtGzPd0hggNEy7BgWtD2WdE-jMlF8xyRQzxWn-3JN

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=vault
POSTGRES_PASSWORD=vault_pass
POSTGRES_DB=vault
# Порт, которым БД проброшена на хост (внутри compose backend ходит в db:5432).
POSTGRES_PORT=5432
# Для запуска backend вне Docker (npm run dev):
DATABASE_URL=postgresql://vault:vault_pass@localhost:5432/vault

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_PORT=3000

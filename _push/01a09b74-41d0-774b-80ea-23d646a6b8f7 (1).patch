+    envScene.add(front);
+
+    // Узкая полоса: даёт вытянутый блик на цилиндрах (монета, барабаны сейфа)
+    const stripe = makePanel(0.7, 7, { color: 0xffffff, intensity: 4.2 });
+    stripe.position.set(-3.4, 2.0, 10.2);

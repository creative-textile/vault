+      let x = Math.random() * w, y = Math.random() * h;
+      ctx.moveTo(x, y);
+      for (let s = 0; s < 7; s++) {
+        x += (Math.random() - 0.5) * 190;
+        y += (Math.random() - 0.5) * 190;
+        ctx.lineTo(x, y);
+      }
+      ctx.stroke();
+    }
+    ctx.globalAlpha = 1;
+    // Виньетка (центр светлее — туда падает прожектор)

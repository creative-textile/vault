+name: CI
+
+# Минимальная проверка на каждый push и pull request: типы, смоук-тесты,
+# схема БД на настоящем PostgreSQL и сборка всех четырёх образов.
+#
+# Почему это появилось: в репозитории не было ни одной автоматической проверки,
+# поэтому вторая копия схемы (db/init.sql) успела разойтись с основной и
+# сломать инициализацию свежего Docker-тома — ошибка 42P01 всплывала только
+# у того, кто поднимал проект с нуля.
+
+on:
+  push:
+    branches: ['**']
+  pull_request:
+  workflow_dispatch:
+
+concurrency:
+  group: ci-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  backend:
+    name: "Backend: типы и смоук-тесты"
+    runs-on: ubuntu-latest
+    defaults:
+      run:
+        working-directory: backend
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 20
+          cache: npm
+          cache-dependency-path: backend/package-lock.json
+      - run: npm ci
+      - name: TypeScript без ошибок
+        run: npx tsc --noEmit
+      # Смоук-тесты работают на pg-mem (живая БД не нужна): даты сейфа, цепочка
+      # раундов, правила взлома, HTTP-маршруты, дуэли, вклады и гонки денег.
+      - name: Смоук-тесты (7 режимов)
+        run: npm test
+
+  schema:
+    name: Схема БД на PostgreSQL 16
+    runs-on: ubuntu-latest
+    services:
+      postgres:
+        image: postgres:16
+        env:
+          POSTGRES_USER: vault
+          POSTGRES_PASSWORD: vault_pass
+          POSTGRES_DB: vault
+        ports:
+          - 5432:5432
+        options: >-
+          --health-cmd "pg_isready -U vault"
+          --health-interval 5s
+          --health-timeout 5s
+          --health-retries 20
+    env:
+      PGHOST: localhost
+      PGPORT: 5432
+      PGUSER: vault
+      PGPASSWORD: vault_pass
+      PGDATABASE: vault
+    steps:
+      - uses: actions/checkout@v4
+      # Так же, как это делает docker-entrypoint-initdb.d: один файл, одна
+      # транзакция, ON_ERROR_STOP=1 — любая ошибка означает красную сборку.
+      - name: init.sql применяется целиком
+        run: psql -v ON_ERROR_STOP=1 -f backend/src/db/init.sql
+      - name: init.sql идемпотентен (второй прогон)
+        run: psql -v ON_ERROR_STOP=1 -f backend/src/db/init.sql
+      - name: Проверка полноты схемы
+        run: psql -v ON_ERROR_STOP=1 -f backend/src/db/schema-check.sql
+
+  frontend:
+    name: "Frontend: типы и сборка"
+    runs-on: ubuntu-latest
+    defaults:
+      run:
+        working-directory: frontend
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 20
+          cache: npm
+          cache-dependency-path: frontend/package-lock.json
+      - run: npm ci
+      - run: npx tsc --noEmit
+      - name: Математика 3D-анимаций и линт шейдеров
+        run: npm test
+      - run: npm run build
+
+  bot:
+    name: "Telegram-бот: типы и сборка"
+    runs-on: ubuntu-latest
+    defaults:
+      run:
+        working-directory: bot
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 20
+          cache: npm
+          cache-dependency-path: bot/package-lock.json
+      - run: npm ci
+      - run: npx tsc --noEmit
+      - run: npm run build
+
+  docker:
+    name: Docker-образы собираются
+    runs-on: ubuntu-latest
+    needs: [backend, schema, frontend, bot]
+    steps:
+      - uses: actions/checkout@v4
+      - name: Образ БД (контекст — корень, схема из backend/src/db/init.sql)
+        run: docker build -f db/Dockerfile -t vault-db:ci .
+      - name: Backend
+        run: docker build -t vault-backend:ci ./backend
+      - name: Frontend
+        run: docker build -t vault-frontend:ci ./frontend
+      - name: Bot
+        run: docker build -t vault-bot:ci ./bot
+      # Композ проверяется отдельно: он поднимает БД из того же Dockerfile и
+      # ждёт её healthcheck, то есть воспроизводит «docker compose up» с нуля.
+      - name: docker compose config валиден
+        run: |
+          cp .env.example .env
+          docker compose config --quiet

+      [w * 0.22, h * 0.36, h * 0.62, 'rgba(88,44,160,0.42)'],
+      [w * 0.62, h * 0.28, h * 0.5, 'rgba(20,90,150,0.36)'],
+      [w * 0.84, h * 0.66, h * 0.46, 'rgba(150,44,96,0.3)'],
+      [w * 0.42, h * 0.74, h * 0.44, 'rgba(40,120,140,0.24)'],
+      [w * 0.1, h * 0.8, h * 0.34, 'rgba(120,80,200,0.2)']

+/** Туманность для космоса (фон ракеты): облака цвета вместо чёрной пустоты. */
+export function nebula(): THREE.CanvasTexture {
+  return cached('nebula:v2', [1024, 512], (ctx, w, h) => {
+    ctx.fillStyle = '#04050e';
+    ctx.fillRect(0, 0, w, h);

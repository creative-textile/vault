+    envScene.add(stripe);
+
+    // Тёплый пол: подсвечивает нижние части объектов
+    const floor = makePanel(16, 16, cfg.floor);
+    floor.position.set(0, -6.6, 0);
+    floor.rotation.x = -Math.PI / 2;
+    envScene.add(floor);
+
+    const rt = pmrem.fromScene(envScene, 0.035);
+    cache.set(preset, rt.texture);
+
+    // Временная сцена больше не нужна — карта запечена в render target
+    envScene.traverse((obj) => {
+      const mesh = obj as THREE.Mesh;
+      mesh.geometry?.dispose();
+      const mat = mesh.material as THREE.Material | THREE.Material[] | undefined;
+      if (Array.isArray(mat)) mat.forEach((m) => m.dispose());
+      else mat?.dispose();
+    });
+    pmrem.dispose();
+    return rt.texture;
+  } catch {
+    pmrem?.dispose();
+    return null;
+  }
+}
+
+/** Освободить все закэшированные карты (при выгрузке приложения). */
+export function disposeEnvironments(): void {
+  for (const [, tex] of cache) tex.dispose();
+  cache.clear();
+}
diff --git a/frontend/src/three/lib/materials.ts b/frontend/src/three/lib/materials.ts
new file mode 100644
index 0000000..616164e
--- /dev/null
+++ b/frontend/src/three/lib/materials.ts
@@ -0,0 +1,161 @@
+/**
+ * Материалы зала: золото, хром, воронёная сталь, крашеный корпус, стекло, неон.
+ *
+ * Собраны в одном месте по двум причинам. Во-первых, «дорогой» вид даёт не
+ * геометрия, а параметры PBR (metalness/roughness/clearcoat/envMapIntensity),
+ * и подбирать их нужно единообразно для всех сцен. Во-вторых, материалы
+ * обязаны переиспользоваться: каждый новый MeshStandardMaterial — это новая
+ * компиляция шейдера, а на мобильном GPU десяток лишних программ означает
+ * подтормаживание первых секунд полёта.
+ */
+import * as THREE from 'three';
+import { brushedMetal, hullPanels } from './textures';
+
+/** Золото: монеты, ручка сейфа, ободки, выигрышные суммы. */
+export function gold(opts: { roughness?: number; envIntensity?: number } = {}): THREE.MeshPhysicalMaterial {
+  const m = new THREE.MeshPhysicalMaterial({
+    color: 0xffd76a,
+    metalness: 1,
+    roughness: opts.roughness ?? 0.22,
+    envMapIntensity: opts.envIntensity ?? 1.55,
+    roughnessMap: brushedMetal({ base: 96, strength: 40, circular: true })
+  });
+  return m;
+}
+
+/** Полированное золото с зеркальным блеском (гурт монеты, акценты). */
+export function polishedGold(): THREE.MeshPhysicalMaterial {
+  return new THREE.MeshPhysicalMaterial({
+    color: 0xfff0b4,
+    metalness: 1,
+    roughness: 0.09,
+    envMapIntensity: 1.9
+  });
+}
+
+/** Хром/серебро: засовы, диски, крепеж. */
+export function chrome(): THREE.MeshPhysicalMaterial {
+  return new THREE.MeshPhysicalMaterial({
+    color: 0xdfe4f2,
+    metalness: 1,
+    roughness: 0.13,
+    envMapIntensity: 1.8
+  });
+}
+
+/** Воронёная сталь: корпус сейфа, тёмные детали. */
+export function darkSteel(opts: { roughness?: number } = {}): THREE.MeshPhysicalMaterial {
+  return new THREE.MeshPhysicalMaterial({
+    color: 0x3a3f57,
+    metalness: 0.94,
+    roughness: opts.roughness ?? 0.42,
+    envMapIntensity: 1.1,
+    roughnessMap: brushedMetal({ base: 150, strength: 34 })
+  });
+}
+
+/** Крашеный корпус ракеты: белый перламутр с лаком (clearcoat). */
+export function paintedHull(): THREE.MeshPhysicalMaterial {
+  return new THREE.MeshPhysicalMaterial({
+    color: 0xf4f6fb,
+    metalness: 0.18,
+    roughness: 0.34,
+    map: hullPanels(),
+    clearcoat: 1,
+    clearcoatRoughness: 0.07,
+    envMapIntensity: 1.15
+  });
+}
+
+/** Красный лак: носовой обтекатель, кили, тревожные элементы. */
+export function paintedRed(): THREE.MeshPhysicalMaterial {
+  return new THREE.MeshPhysicalMaterial({
+    color: 0xd81f3f,
+    metalness: 0.3,
+    roughness: 0.26,
+    clearcoat: 1,
+    clearcoatRoughness: 0.06,
+    envMapIntensity: 1.3
+  });
+}
+
+/** Тёмный композит (углеродное волокно на вид): площадки, постаменты. */
+export function composite(): THREE.MeshPhysicalMaterial {
+  return new THREE.MeshPhysicalMaterial({
+    color: 0x181c33,
+    metalness: 0.55,
+    roughness: 0.55,
+    envMapIntensity: 0.85
+  });
+}
+
+/**
+ * Стекло иллюминатора: настоящее преломление (transmission), а не плоский
+ * синий кружок. `thickness` даёт глубину, `iridescence` — лёгкий перелив.
+ */
+export function glass(opts: { color?: number; attenuation?: number } = {}): THREE.MeshPhysicalMaterial {
+  return new THREE.MeshPhysicalMaterial({
+    color: opts.color ?? 0x9fd8ff,
+    metalness: 0,
+    roughness: 0.04,
+    transmission: 0.94,
+    thickness: 0.42,
+    ior: 1.5,
+    iridescence: 0.4,
+    iridescenceIOR: 1.3,
+    attenuationColor: new THREE.Color(0x2b7fff),
+    attenuationDistance: opts.attenuation ?? 1.4,
+    envMapIntensity: 2.1,
+    clearcoat: 1,
+    clearcoatRoughness: 0.02,
+    transparent: true
+  });
+}
+
+/**
+ * Неоновая emissive-поверхность: ленты, индикаторы, кольца арены.
+ * `toneMapped: false` обязателен — иначе bloom не получит «горячих» значений
+ * и свечение будет грязно-серым вместо яркого неона.
+ */
+export function neon(color: number, intensity = 2.6): THREE.MeshBasicMaterial {
+  const m = new THREE.MeshBasicMaterial({ color, toneMapped: false });
+  m.color.multiplyScalar(intensity);
+  return m;
+}
+
+/** Прозрачный аддитивный слой (пламя, ореолы, ударные волны). */
+export function additive(color: number, opacity = 1): THREE.MeshBasicMaterial {
+  return new THREE.MeshBasicMaterial({
+    color,
+    transparent: true,
+    opacity,
+    blending: THREE.AdditiveBlending,
+    depthWrite: false,
+    side: THREE.DoubleSide,
+    toneMapped: false
+  });
+}
+
+/** Бархат/мягкая ткань арены: почти без бликов, глубокий цвет. */
+export function velvet(color = 0x2a0f45): THREE.MeshStandardMaterial {
+  return new THREE.MeshStandardMaterial({
+    color,
+    metalness: 0,
+    roughness: 0.95,
+    envMapIntensity: 0.4
+  });
+}
+
+/** Рекурсивно освободить геометрию и материалы объекта (защита от утечек GPU). */
+export function disposeObject(root: THREE.Object3D): void {
+  root.traverse((obj) => {
+    const mesh = obj as THREE.Mesh;
+    if (mesh.geometry) mesh.geometry.dispose();
+    const mat = mesh.material as THREE.Material | THREE.Material[] | undefined;
+    if (Array.isArray(mat)) mat.forEach((m) => m.dispose());
+    else if (mat) {
+      // Текстуры материала живут в общем кэше — их не трогаем
+      mat.dispose();
+    }
+  });
+}
diff --git a/frontend/src/three/lib/particles.ts b/frontend/src/three/lib/particles.ts
new file mode 100644
index 0000000..8f3a0e2
--- /dev/null
+++ b/frontend/src/three/lib/particles.ts
@@ -0,0 +1,160 @@
+/**
+ * Пул частиц: дым, искры, угли, пыль, блики.
+ *
+ * Один THREE.Points на тип эффекта вместо сотен отдельных мешей — иначе
+ * draw calls съедают кадр на мобильном GPU. Частицы живут в предварительно
+ * выделенных Float32Array и переиспользуются по кругу (никаких аллокаций в
+ * кадре, значит и никакого сборщика мусора посреди полёта).
+ *
+ * Размер считается в вершинном шейдере от расстояния до камеры, поэтому
+ * частицы не «плывут» при наезде камеры и выглядят объёмными.
+ */
+import * as THREE from 'three';
+
+export interface ParticleFieldOptions {
+  color?: number;
+  size?: number;
+  gravity?: number;
+  drag?: number;
+  blending?: THREE.Blending;
+  opacity?: number;
+  /** Множитель размера в шейдере (подбирается под масштаб сцены). */
+  scale?: number;
+}
+
+export class ParticleField {
+  readonly points: THREE.Points;
+  private readonly pos: Float32Array;
+  private readonly alpha: Float32Array;
+  private readonly size: Float32Array;
+  private readonly vel: Float32Array;
+  private readonly life: Float32Array;
+  private readonly maxLife: Float32Array;
+  private readonly count: number;
+  private readonly gravity: number;
+  private readonly drag: number;
+  private cursor = 0;
+
+  constructor(count: number, texture: THREE.Texture, opts: ParticleFieldOptions = {}) {
+    this.count = Math.max(1, count);
+    this.gravity = opts.gravity ?? 0;
+    this.drag = opts.drag ?? 0.985;
+    this.pos = new Float32Array(this.count * 3);
+    this.alpha = new Float32Array(this.count);
+    this.size = new Float32Array(this.count);
+    this.vel = new Float32Array(this.count * 3);
+    this.life = new Float32Array(this.count);
+    this.maxLife = new Float32Array(this.count);
+    for (let i = 0; i < this.count; i++) {
+      this.pos[i * 3 + 1] = -9999;               // неактивные частицы за кадром
+      this.size[i] = opts.size ?? 1;
+    }
+
+    const geo = new THREE.BufferGeometry();
+    geo.setAttribute('position', new THREE.BufferAttribute(this.pos, 3));
+    geo.setAttribute('aAlpha', new THREE.BufferAttribute(this.alpha, 1));
+    geo.setAttribute('aSize', new THREE.BufferAttribute(this.size, 1));
+
+    const mat = new THREE.ShaderMaterial({
+      uniforms: {
+        uTex: { value: texture },
+        uColor: { value: new THREE.Color(opts.color ?? 0xffffff) },
+        uScale: { value: opts.scale ?? 260 },
+        uOpacity: { value: opts.opacity ?? 1 }
+      },
+      vertexShader: /* glsl */`
+        attribute float aAlpha;
+        attribute float aSize;
+        uniform float uScale;
+        varying float vAlpha;
+        void main() {
+          vAlpha = aAlpha;
+          vec4 mv = modelViewMatrix * vec4(position, 1.0);
+          gl_PointSize = aSize * uScale / max(0.001, -mv.z);
+          gl_Position = projectionMatrix * mv;
+        }`,
+      fragmentShader: /* glsl */`
+        uniform sampler2D uTex;
+        uniform vec3 uColor;
+        uniform float uOpacity;
+        varying float vAlpha;
+        void main() {
+          vec4 t = texture2D(uTex, gl_PointCoord);
+          float a = t.a * vAlpha * uOpacity;
+          if (a < 0.004) discard;
+          gl_FragColor = vec4(uColor * t.rgb, a);
+        }`,
+      transparent: true,
+      depthWrite: false,
+      blending: opts.blending ?? THREE.AdditiveBlending
+    });
+
+    this.points = new THREE.Points(geo, mat);
+    this.points.frustumCulled = false;
+  }
+
+  /**
+   * Выпустить частицу. `p` и `v` читаются сразу и не сохраняются, поэтому
+   * можно передавать один и тот же временный вектор раз за разом.
+   */
+  emit(p: THREE.Vector3, v: THREE.Vector3, life: number, size?: number): void {
+    const i = this.cursor;
+    this.cursor = (this.cursor + 1) % this.count;
+    this.pos[i * 3] = p.x; this.pos[i * 3 + 1] = p.y; this.pos[i * 3 + 2] = p.z;
+    this.vel[i * 3] = v.x; this.vel[i * 3 + 1] = v.y; this.vel[i * 3 + 2] = v.z;
+    this.life[i] = life;
+    this.maxLife[i] = life;
+    if (size !== undefined) this.size[i] = size;
+    this.alpha[i] = 1;
+  }
+
+  update(dt: number): void {
+    let touched = false;
+    for (let i = 0; i < this.count; i++) {
+      if (this.life[i] <= 0) {
+        if (this.alpha[i] !== 0) { this.alpha[i] = 0; touched = true; }
+        continue;
+      }
+      this.life[i] -= dt;
+      const k = Math.max(0, this.life[i] / this.maxLife[i]);
+      this.alpha[i] = k * k;                        // квадратичный спад мягче
+      this.vel[i * 3 + 1] += this.gravity * dt;
+      const d = Math.pow(this.drag, dt * 60);       // drag не зависит от FPS
+      this.vel[i * 3] *= d; this.vel[i * 3 + 1] *= d; this.vel[i * 3 + 2] *= d;
+      this.pos[i * 3] += this.vel[i * 3] * dt;
+      this.pos[i * 3 + 1] += this.vel[i * 3 + 1] * dt;
+      this.pos[i * 3 + 2] += this.vel[i * 3 + 2] * dt;
+      if (this.life[i] <= 0) this.pos[i * 3 + 1] = -9999;
+      touched = true;
+    }
+    if (!touched) return;
+    const g = this.points.geometry;
+    (g.getAttribute('position') as THREE.BufferAttribute).needsUpdate = true;
+    (g.getAttribute('aAlpha') as THREE.BufferAttribute).needsUpdate = true;
+    (g.getAttribute('aSize') as THREE.BufferAttribute).needsUpdate = true;
+  }
+
+  setScale(scale: number): void {
+    (this.points.material as THREE.ShaderMaterial).uniforms.uScale.value = scale;
+  }
+
+  setColor(color: number): void {
+    (this.points.material as THREE.ShaderMaterial).uniforms.uColor.value.setHex(color);
+  }
+
+  clear(): void {
+    for (let i = 0; i < this.count; i++) {
+      this.life[i] = 0;
+      this.alpha[i] = 0;
+      this.pos[i * 3 + 1] = -9999;
+    }
+    const g = this.points.geometry;
+    (g.getAttribute('position') as THREE.BufferAttribute).needsUpdate = true;
+    (g.getAttribute('aAlpha') as THREE.BufferAttribute).needsUpdate = true;
+  }
+
+  dispose(): void {
+    this.points.geometry.dispose();
+    (this.points.material as THREE.Material).dispose();
+  }
+}
diff --git a/frontend/src/three/lib/rng.ts b/frontend/src/three/lib/rng.ts
new file mode 100644
index 0000000..1207c49
--- /dev/null
+++ b/frontend/src/three/lib/rng.ts
@@ -0,0 +1,59 @@
+/**
+ * Детерминированный ГПСЧ для 3D-сцен.
+ *
+ * Звёзды, обломки, искры и пыль должны быть одинаковыми у всех игроков и при
+ * повторе (replay_seed приходит с сервера), иначе реплей выглядел бы другим
+ * раундом. Тот же алгоритм, что и раньше (FNV-1a + LCG), вынесен в общий модуль.
+ */
+export function createRng(seed: string | number) {
+  let hash = 2166136261;
+  const str = String(seed);
+  for (let i = 0; i < str.length; i++) hash = Math.imul(hash ^ str.charCodeAt(i), 16777619);
+  if (hash === 0) hash = 2166136261;
+
+  /** Следующее значение [0, 1). */
+  const rand = (): number => {
+    hash = (Math.imul(hash, 1664525) + 1013904223) >>> 0;
+    return hash / 0x100000000;
+  };
+
+  return {
+    rand,
+    /** [min, max) */
+    range: (min: number, max: number): number => min + rand() * (max - min),
+    /** Целое [min, max] */
+    int: (min: number, max: number): number => Math.floor(min + rand() * (max - min + 1)),
+    /** ±amplitude */
+    spread: (amplitude: number): number => (rand() - 0.5) * 2 * amplitude,
+    /** Случайная точка на сфере радиуса r */
+    onSphere: (r: number): [number, number, number] => {
+      const u = rand() * 2 - 1;
+      const t = rand() * Math.PI * 2;
+      const s = Math.sqrt(Math.max(0, 1 - u * u));
+      return [r * s * Math.cos(t), r * u, r * s * Math.sin(t)];
+    }
+  };
+}
+
+export type Rng = ReturnType<typeof createRng>;
+
+/** Плавный шум 1D (для дрожания пламени, мерцания света): сумма синусоид. */
+export function fbm1(x: number): number {
+  return (
+    Math.sin(x * 1.0) * 0.5 +
+    Math.sin(x * 2.31 + 1.7) * 0.28 +
+    Math.sin(x * 4.77 + 3.1) * 0.15 +
+    Math.sin(x * 9.13 + 5.3) * 0.07
+  );
+}
+
+/** Ease-out cubic: объекты «влетают» и мягко останавливаются. */
+export const easeOutCubic = (t: number): number => 1 - Math.pow(1 - t, 3);
+/** Ease-in-out: для плавных перелётов камеры. */
+export const easeInOut = (t: number): number => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);
+/** Перелёт с отскоком (пружина) — для приземлений и появления объектов. */
+export const easeOutBack = (t: number): number => {
+  const c1 = 1.70158;
+  const c3 = c1 + 1;
+  return 1 + c3 * Math.pow(t - 1, 3) + c1 * Math.pow(t - 1, 2);
+};
diff --git a/frontend/src/three/lib/stage.ts b/frontend/src/three/lib/stage.ts
new file mode 100644
index 0000000..b6805a4
--- /dev/null
+++ b/frontend/src/three/lib/stage.ts
@@ -0,0 +1,263 @@
+/**
+ * Общая сцена-«сцена» (stage): renderer + камера + окружение + bloom + ресайз
+ * + авто-снижение качества.
+ *
+ * Зачем один модуль на четыре зала: раньше каждая сцена сама создавала
+ * WebGLRenderer со своими настройками, из-за чего цвет и резкость отличались
+ * от экрана к экрану (в Ракете был alpha и без tone mapping, в Дуэли —
+ * непрозрачный фон и свои света). Плюс нигде не освобождались геометрии, и
+ * после нескольких партий память GPU росла.
+ *
+ * Авто-снижение качества обязательно: bloom и transmission (стекло) на слабых
+ * Android дают 12–18 FPS, и игра выглядит «сломанной». Замеряем реальный FPS
+ * первые секунды и, если он ниже порога, гасим bloom и режем pixelRatio —
+ * картинка остаётся той же композицией, просто без постобработки.
+ */
+import * as THREE from 'three';
+import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
+import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
+import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
+import { OutputPass } from 'three/addons/postprocessing/OutputPass.js';
+import { getEnvironment, type EnvPreset } from './environment';
+
+export type Quality = 'high' | 'medium' | 'low';
+
+/** Оценка возможностей устройства до первого кадра. */
+export function detectQuality(): Quality {
+  if (typeof navigator === 'undefined') return 'medium';
+  const cores = navigator.hardwareConcurrency ?? 4;
+  const mem = (navigator as unknown as { deviceMemory?: number }).deviceMemory ?? 4;
+  const dpr = window.devicePixelRatio || 1;
+  // Очень маленькие экраны в паре с высоким DPR — почти всегда бюджетные устройства
+  const weak = cores <= 4 || mem <= 3;
+  if (cores >= 8 && mem >= 6 && dpr <= 3) return 'high';
+  if (weak && dpr >= 3) return 'low';
+  return weak ? 'medium' : 'high';
+}
+
+export interface StageOptions {
+  container: HTMLElement;
+  preset?: EnvPreset;
+  /** Сила свечения: 0 полностью отключает bloom (дешевле на слабых устройствах). */
+  bloom?: number;
+  bloomRadius?: number;
+  bloomThreshold?: number;
+  transparent?: boolean;
+  background?: number | null;
+  fog?: { color: number; density: number } | null;
+  fov?: number;
+  position?: [number, number, number];
+  quality?: Quality;
+  /** Ограничение pixelRatio: для bloom-сцен дешевле держать 1.5–1.75. */
+  maxPixelRatio?: number;
+  exposure?: number;
+}
+
+export interface Stage {
+  renderer: THREE.WebGLRenderer;
+  scene: THREE.Scene;
+  camera: THREE.PerspectiveCamera;
+  composer: EffectComposer | null;
+  quality: Quality;
+  /** Пересобрать composer (после ресайза или смены качества). */
+  setSize: () => void;
+  /** Кадр. Возвращает false, если сцену уже уничтожили. */
+  render: () => void;
+  /** Замер FPS и авто-деградация; вызвать в цикле анимации. */
+  tickPerf: () => void;
+  setBloom: (strength: number) => void;
+  dispose: () => void;
+  width: () => number;
+  height: () => number;
+}
+
+export function createStage(opts: StageOptions): Stage {
+  const { container } = opts;
+  const quality: Quality = opts.quality ?? detectQuality();
+  const reduced = typeof matchMedia === 'function' && matchMedia('(prefers-reduced-motion: reduce)').matches;
+
+  const width = Math.max(1, container.clientWidth);
+  const height = Math.max(1, container.clientHeight);
+
+  const renderer = new THREE.WebGLRenderer({
+    antialias: quality !== 'low',
+    alpha: opts.transparent ?? false,
+    powerPreference: 'high-performance',
+    stencil: false,
+    depth: true
+  });
+  const capByQuality = quality === 'high' ? 2 : quality === 'medium' ? 1.65 : 1.25;
+  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, opts.maxPixelRatio ?? capByQuality));
+  renderer.setSize(width, height, false);
+  renderer.toneMapping = THREE.ACESFilmicToneMapping;
+  renderer.toneMappingExposure = opts.exposure ?? 1.08;
+  renderer.outputColorSpace = THREE.SRGBColorSpace;
+  renderer.shadowMap.enabled = quality === 'high';
+  renderer.shadowMap.type = THREE.PCFSoftShadowMap;
+  if (opts.transparent) renderer.setClearColor(0x000000, 0);
+  container.appendChild(renderer.domElement);
+
+  const scene = new THREE.Scene();
+  if (opts.background !== undefined && opts.background !== null) {
+    scene.background = new THREE.Color(opts.background);
+  }
+  if (opts.fog) scene.fog = new THREE.FogExp2(opts.fog.color, opts.fog.density);
+
+  const camera = new THREE.PerspectiveCamera(opts.fov ?? 50, width / height, 0.1, 400);
+  if (opts.position) camera.position.set(...opts.position);
+
+  // Окружение: отражения в металле и стекле (главный источник «дороговизны»)
+  const env = getEnvironment(renderer, opts.preset ?? 'vault');
+  if (env) scene.environment = env;
+
+  /* ── Постобработка: bloom ─────────────────────────────────────────────── */
+  let composer: EffectComposer | null = null;
+  let bloomPass: UnrealBloomPass | null = null;
+
+  const bloomStrength = reduced ? 0 : (opts.bloom ?? 0);
+  const wantBloom = bloomStrength > 0 && quality !== 'low';
+
+  if (wantBloom) {
+    try {
+      composer = new EffectComposer(renderer);
+      composer.setPixelRatio(renderer.getPixelRatio());
+      composer.setSize(width, height);
+      composer.addPass(new RenderPass(scene, camera));
+      bloomPass = new UnrealBloomPass(
+        new THREE.Vector2(width, height),
+        bloomStrength,
+        opts.bloomRadius ?? 0.62,
+        opts.bloomThreshold ?? 0.72
+      );
+      composer.addPass(bloomPass);
+      // OutputPass применяет tone mapping и sRGB: без него после composer
+      // картинка уходит в блёклый linear-вид
+      composer.addPass(new OutputPass());
+    } catch {
+      composer = null;
+      bloomPass = null;
+    }
+  }
+
+  const setSize = () => {
+    const w = Math.max(1, container.clientWidth);
+    const h = Math.max(1, container.clientHeight);
+    camera.aspect = w / h;
+    camera.updateProjectionMatrix();
+    renderer.setSize(w, h, false);
+    composer?.setSize(w, h);
+    bloomPass?.setSize(w, h);
+  };
+
+  /* ── Ресайз: ResizeObserver ловит и поворот экрана, и открытие клавиатуры ─ */
+  let ro: ResizeObserver | null = null;
+  if (typeof ResizeObserver !== 'undefined') {
+    ro = new ResizeObserver(() => setSize());
+    ro.observe(container);
+  }
+  window.addEventListener('resize', setSize);
+  window.addEventListener('orientationchange', setSize);
+
+  /* ── Замер FPS и авто-деградация ─────────────────────────────────────── */
+  let frames = 0;
+  let windowStart = performance.now();
+  let degraded = false;
+  let disposed = false;
+
+  const tickPerf = () => {
+    if (disposed || degraded) return;
+    frames++;
+    const now = performance.now();
+    const elapsed = now - windowStart;
+    if (elapsed < 1600) return;
+    const fps = (frames * 1000) / elapsed;
+    frames = 0;
+    windowStart = now;
+
+    // Меньше 34 FPS два замера подряд — гасим bloom и режем pixelRatio.
+    // Композиция сцены не меняется, поэтому деградация не выглядит «поломкой».
+    if (fps < 34) {
+      degraded = true;
+      if (bloomPass) bloomPass.strength = 0;
+      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.1));
+      setSize();
+      if (renderer.shadowMap.enabled) {
+        renderer.shadowMap.enabled = false;
+        scene.traverse((o) => {
+          const m = o as THREE.Mesh;
+          if (m.material) {
+            const list = Array.isArray(m.material) ? m.material : [m.material];
+            list.forEach((x) => { x.needsUpdate = true; });
+          }
+        });
+      }
+      console.info(`[3d] FPS ${fps.toFixed(0)} — постобработка отключена для плавности`);
+    }
+  };
+
+  const render = () => {
+    if (disposed) return;
+    if (composer) composer.render();
+    else renderer.render(scene, camera);
+  };
+
+  const setBloom = (strength: number) => {
+    if (bloomPass && !degraded) bloomPass.strength = strength;
+  };
+
+  const dispose = () => {
+    if (disposed) return;
+    disposed = true;
+    ro?.disconnect();
+    window.removeEventListener('resize', setSize);
+    window.removeEventListener('orientationchange', setSize);
+    composer?.dispose?.();
+    bloomPass?.dispose?.();
+    renderer.dispose();
+    renderer.forceContextLoss?.();
+    if (renderer.domElement.parentNode === container) container.removeChild(renderer.domElement);
+  };
+
+  return {
+    renderer, scene, camera, composer, quality,
+    setSize, render, tickPerf, setBloom, dispose,
+    width: () => Math.max(1, container.clientWidth),
+    height: () => Math.max(1, container.clientHeight)
+  };
+}
+
+/**
+ * То же, что createStage, но не бросает исключение.
+ *
+ * WebGL может отсутствовать (отключён в настройках WebView, контекст исчерпан
+ * после нескольких залов, старый Android). Игра обязана остаться играбельной:
+ * сцена просто не появляется, а экран продолжает работать с цифрами из БД.
+ */
+export function createStageSafe(opts: StageOptions): Stage | null {
+  try {
+    return createStage(opts);
+  } catch (e) {
+    console.warn('[3d] сцена не создана:', (e as Error)?.message || e);
+    return null;
+  }
+}
+
+/** Кадровый цикл с автоматической остановкой при уничтожении сцены. */
+export function startLoop(stage: Stage, frame: (dt: number, elapsed: number) => void): () => void {
+  let id = 0;
+  let last = performance.now();
+  const start = performance.now();
+  const step = () => {
+    const now = performance.now();
+    // Ограничиваем dt: после возврата из фоновой вкладки иначе проходит
+    // «час» симуляции за один кадр, и объекты улетают за пределы сцены
+    const dt = Math.min(0.05, (now - last) / 1000);
+    last = now;
+    frame(dt, (now - start) / 1000);
+    stage.render();
+    stage.tickPerf();
+    id = requestAnimationFrame(step);
+  };
+  id = requestAnimationFrame(step);
+  return () => cancelAnimationFrame(id);
+}

{
  "name": "vault-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "test": "npm run test:scene && npm run test:shaders",
    "test:shaders": "node tests/shader-lint.mjs",
    "test:scene": "esbuild tests/scene-math.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/scene-math.mjs --log-level=warning && node node_modules/.cache/scene-math.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "@pmndrs/assets": "^1.7.0",
    "@twa-dev/sdk": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "socket.io-client": "^4.7.5",
    "three": "^0.164.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.164.1",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  }
}
